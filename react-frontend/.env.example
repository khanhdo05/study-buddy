# Public browser configuration from Supabase Project Settings > API.
# Never put a secret/service-role key in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Used only by the local Vite server proxy; never expose this as VITE_AGENT_API_KEY.
AGENT_API_KEY=local-dev-key
# Optional override for the learner-agent URL.
VITE_LEARNER_AGENT_URL=http://127.0.0.1:8000
